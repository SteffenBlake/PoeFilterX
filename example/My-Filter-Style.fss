hidden {
    show: false;
    bg-color: 150 200 200 200;
}
med-value {
    show: true;
    bg-color: 255 255 119 255;
    icon-size: 1;
    icon-color: Yellow;
}
high-value {
    show: true;
    bg-color: 255 255 255 255;
    icon-size: 0;
    icon-color: Red;
}
gear {
    icon-shape: Diamond;
}

low-value {
    show: true;
    bg-color: 80 80 80 255;
    icon-size: 2;
    icon-color: Grey;
}

calibration-small {
    show: false;
    font-size: 1;
    font-color: 255 255 255;
    border-color: 255 210 90;
    bg-color: 15 15 15 240;
    icon: 1 Yellow Diamond;
}
calibration-large {
    show: true;
    font-size: 45;
    font-color: 255 255 255;
    border-color: 255 210 90;
    bg-color: 15 15 15 240;
    icon: 1 Yellow Diamond;
}

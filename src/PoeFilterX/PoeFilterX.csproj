<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\PoeFilterX.Engine\PoeFilterX.Engine.csproj" />
    <ProjectReference Include="..\PoeFilterX.LanguageServer\PoeFilterX.LanguageServer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="11.0.0" />
    <PackageReference Include="System.CommandLine" Version="3.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>poefilterx</ToolCommandName>
    <PackageId>PoeFilterX</PackageId>
    <Description>Compiler and language server for PoeFilterX filters and filter stylesheets.</Description>
    <Authors>SteffenBlake</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/SteffenBlake/PoeFilterX</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../resources/branding/poefilterx-nuget.png" Pack="true" PackagePath="/icon.png" />
  </ItemGroup>

</Project>
